# Local-only secrets/flags for wrangler dev (gitignored as .dev.vars).
# Copy to apps/pms-core/.dev.vars — never put these in wrangler.jsonc top-level vars.
#
# HOSPAI_UNSAFE_LOCAL=1 is required before any of the dangerous flags take effect.
# The Worker refuses to serve if simulate / ALLOW_DEV_ACTOR is set without this marker.

HOSPAI_UNSAFE_LOCAL=1
HOSPAI_JURISDICTION_MODE=simulate
HOSPAI_PSP_MODE=simulate
HOSPAI_ALLOW_DEV_ACTOR=1
# 32-byte hex (64 chars) — wraps guest PII data keys in OrgDO (required for guests.create / booking)
HOSPAI_ORG_MASTER_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
# Clerk (demo happy path). Optional CLERK_JWT_KEY is a PEM; SDK fetches JWKS if omitted.
# CLERK_SECRET_KEY=sk_test_…
# CLERK_PUBLISHABLE_KEY=pk_test_…
# CLERK_JWT_KEY=
# CLERK_AUTHORIZED_PARTIES=http://localhost:5173
# Copilot (R4.16). Off unless configured; under HOSPAI_UNSAFE_LOCAL the copilot falls back to
# a deterministic fake model, so the demo works without a provider. The key is a secret.
# COPILOT_PROVIDER=anthropic selects the native Anthropic adapter (needs COPILOT_MODEL and COPILOT_API_KEY;
# COPILOT_BASE_URL is optional).
# COPILOT_PROVIDER=
# COPILOT_BASE_URL=
# COPILOT_MODEL=
# COPILOT_API_KEY=
