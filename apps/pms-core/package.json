{
  "name": "@hospai/pms-core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir=dist",
    "test": "vitest run --shard=1/4 && vitest run --shard=2/4 && vitest run --shard=3/4 && vitest run --shard=4/4",
    "test:unsharded": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'lint via root eslint'",
    "dev": "wrangler dev"
  },
  "dependencies": {
    "@clerk/backend": "3.13.2",
    "@hospai/contracts": "workspace:*",
    "@hospai/crypto-shredding": "workspace:*",
    "@hospai/do-runtime": "workspace:*",
    "@hospai/entitlement-client": "workspace:*",
    "@hospai/kernel": "workspace:*",
    "@hospai/money": "workspace:*",
    "@hospai/observability": "workspace:*",
    "@hospai/pms-housekeeping": "workspace:*",
    "@hospai/pms-inventory": "workspace:*",
    "@hospai/pms-rates": "workspace:*",
    "@hospai/pms-reservations": "workspace:*",
    "@hospai/pms-restrictions": "workspace:*",
    "@hospai/tenant-router": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.36",
    "@cloudflare/workers-types": "^4.20250726.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9",
    "wrangler": "^4.26.0"
  }
}
