{
  "name": "hospai-pms-core",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "PROPERTY_DO",
        "class_name": "PropertyDO"
      },
      {
        "name": "ORG_DO",
        "class_name": "OrgDO"
      },
      {
        "name": "ORG_ENTITLEMENT_DO",
        "class_name": "OrgEntitlementDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PropertyDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["OrgDO"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["OrgEntitlementDO"]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ENTITLEMENT_KV",
      "id": "00000000-0000-0000-0000-000000000002"
    },
    {
      "binding": "EVENT_DEDUPE_KV",
      "id": "00000000-0000-0000-0000-000000000003"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENTS_QUEUE",
        "queue": "hospai-events"
      }
    ],
    "consumers": [
      {
        "queue": "hospai-events",
        "max_batch_size": 100,
        "max_batch_timeout": 5
      }
    ]
  },
  "workflows": [
    {
      "binding": "NIGHT_AUDIT_WORKFLOW",
      "name": "hospai-night-audit",
      "class_name": "NightAuditWorkflow"
    }
  ],
  "d1_databases": [
    {
      "binding": "PLATFORM_DB",
      "database_name": "hospai-platform",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../migrations/d1-platform"
    }
  ]
}
