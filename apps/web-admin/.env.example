# SPA build/dev variables (Vite reads apps/web-admin/.env.local; never commit it).
# The ops Clerk instance's publishable key (pk_test_... / pk_live_...). NOT the hotel app's key.
VITE_CLERK_PUBLISHABLE_KEY=

# Local dev only: skip Clerk and send `x-dev-operator: <email>` instead. The Worker honours the
# header only when its .dev.vars sets BOTH HOSPAI_UNSAFE_LOCAL=1 and OPS_ALLOW_DEV_OPERATOR=1.
# VITE_USE_DEV_OPERATOR=1
# VITE_DEV_OPERATOR_EMAIL=dev-operator@example.test
