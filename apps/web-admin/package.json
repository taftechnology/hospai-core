{
  "name": "@hospai/web-admin",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p src/worker/tsconfig.json --noEmit && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/worker/tsconfig.json --noEmit",
    "lint": "echo 'lint via root eslint'"
  },
  "dependencies": {
    "@clerk/backend": "3.13.2",
    "@clerk/react": "^6.14.2",
    "@hospai/contracts": "workspace:*",
    "@hospai/http-security": "workspace:*",
    "@hospai/ui-kit": "workspace:*",
    "@tanstack/react-query": "^5.74.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250726.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.8.2",
    "vite": "^6.3.3",
    "vitest": "^3.0.9",
    "wrangler": "^4.166.0"
  }
}
