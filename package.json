{
  "name": "hospai-core",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "pnpm exec turbo run test:coverage --filter=!@hospai/pms-core",
    "test:local": "pnpm exec turbo run test --filter=!@hospai/pms-core && node scripts/test-pms-core-shards.mjs",
    "lint": "eslint . && turbo run lint",
    "typecheck": "turbo run typecheck",
    "generate:ddl": "pnpm --filter @hospai/do-runtime build && node scripts/property-ddl.mjs --write",
    "check:ddl": "node scripts/property-ddl.mjs --check",
    "check:entitlements": "pnpm --filter @hospai/contracts build && pnpm --filter @hospai/do-runtime build && node scripts/entitlements-check.mjs",
    "check:permissions": "pnpm --filter @hospai/contracts build && node scripts/permissions-check.mjs",
    "check:degraded": "pnpm --filter @hospai/contracts build && node scripts/degraded-check.mjs",
    "check:class-denylist": "pnpm --filter eslint-plugin-hospai build && node scripts/class-denylist-check.mjs",
    "check:forbidden-bodies": "pnpm --filter @hospai/contracts build && node scripts/forbidden-body-check.mjs",
    "check:do-transport-guards": "pnpm --filter @hospai/contracts build && node scripts/do-transport-guards-check.mjs",
    "check:web-pms-colors": "node scripts/web-pms-colors-check.mjs",
    "check:class-resolution": "node scripts/class-resolution-check.mjs",
    "check:ui-kit-adoption": "node scripts/ui-kit-adoption-check.mjs",
    "check:spa-page-chrome": "node scripts/spa-page-chrome-check.mjs",
    "check:web-pms-me-gating": "node scripts/web-pms-me-gating-check.mjs",
    "check:pms-core-test-dates": "node scripts/pms-core-test-dates-check.mjs",
    "check:module-manifests": "pnpm --filter @hospai/kernel build && node scripts/module-manifests-check.mjs",
    "check:purge": "pnpm --filter @hospai/contracts build && node scripts/purge-check.mjs",
    "demo:seed": "node scripts/demo-seed.mjs",
    "smoke:staging": "node scripts/smoke-staging.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.9",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^9.22.0",
    "eslint-plugin-hospai": "workspace:*",
    "turbo": "^2.5.4",
    "typescript": "^5.8.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd", "sharp"]
  }
}
