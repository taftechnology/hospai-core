    "lint": "echo 'lint via root eslint'"
  },
  "dependencies": {
    "@hospai/contracts": "workspace:*",
    "@hospai/pms-housekeeping": "workspace:*",
    "@hospai/pms-products": "workspace:*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
